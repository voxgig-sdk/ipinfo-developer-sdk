      "contract": {
        "operationId": "getPlusFieldByIp",
        "parameters": [
          {
            "description": "A single IPv4 or IPv6 IP address.",
            "in": "path",
            "name": "ip",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A specific field from the plus response or nested geo/as/mobile/anonymous fields.",
            "in": "path",
            "name": "field",
            "required": true,
            "schema": {
              "enum": [
                "ip",
                "geo",
                "geo/city",
                "geo/region",
                "geo/region_code",
                "geo/country",
                "geo/country_code",
                "geo/continent",
