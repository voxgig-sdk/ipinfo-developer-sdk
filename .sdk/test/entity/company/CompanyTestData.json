                        },
                        "title": {
                          "example": "Wrong ip",
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "message"
                      ],
                      "type": "object"
                    },
                    "status": {
                      "example": 404,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Wrong ip. Please provide a valid IP address."
          },
          "429": {
