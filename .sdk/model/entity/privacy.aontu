    }
    vpn: {
      h: "Vpn"
      n: "vpn"
      r: true
      t: "`$BOOLEAN`"
    }
  }

  name: "privacy"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /{ip}/privacy"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "ip"
                or: "ip"
