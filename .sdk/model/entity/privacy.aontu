# Entity: privacy

main: kit: entity: privacy: {

  alias: field: {}

  fields: {
    hosting: {
      h: "Hosting"
      n: "hosting"
      r: true
      t: "`$BOOLEAN`"
    }
    proxy: {
      h: "Proxy"
      n: "proxy"
      r: true
      t: "`$BOOLEAN`"
    }
    relay: {
      h: "Relay"
      n: "relay"
      r: true
      t: "`$BOOLEAN`"
    }
    service: {
      h: "Service"
      n: "service"
      r: true
